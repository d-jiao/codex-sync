# Binaries
bin/codex-sync
bin/codex-sync.exe
bin/codex-sync-*

# Root-level build output. `make build` targets ./bin, but a plain
# `go build -o codex-sync ./cmd/codex-sync` drops a ~55MB binary here,
# which a `git add -A` would commit into history permanently.
/codex-sync
/codex-sync.exe

*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Dependency directories
vendor/
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Local config (contains secrets)
.codex-sync/
.npmrc
.env
.env.*

# Claude Code worktrees
.claude/worktrees/

# superpowers SDD workspace (ledger, briefs, review packages)
.superpowers/
